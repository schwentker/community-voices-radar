# Neon connection string (from Neon dashboard > Connection Details > Connection string)
# Use the "pooled" URL for production (includes ?pgbouncer=true)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Port for the HTTP server (SSE + health)
PORT=3000

# Bearer token clients send to the MCP server
# COMM_VOICES_API_TOKEN=your-community-voices-api-token

# Optional. Without it the watchlist is saved to data/watchlist.local.json and posts stay in memory.
# WATCHLIST_FILE=data/watchlist.local.json

# Browser origins allowed to change the watchlist (the radar UI dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First boot only: seeds a "Default watch" entry. After that, use the Watchlist panel.
# Reddit search query to track (any product, framework, or topic)
REDDIT_SEARCH_QUERY="model context protocol" OR mcp server

# Comma-separated public Discourse forums to ingest
DISCOURSE_BASE_URLS=https://forum.example.com,https://community.example.org

# Optional: route_signal POSTs ranked signals here (Slack incoming webhook, Zapier, n8n, etc.)
SIGNAL_WEBHOOK_URL=

# Signal pipeline (planned; the radar UI shows a mockup, nothing reads these yet)
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_CONCURRENCY=8
# Hard caps per run. Tokens are reserved before attempts (including retries); unknown usage stays charged.
JEV_MAX_ATTEMPTS_PER_RUN=4000
JEV_MAX_INPUT_TOKENS_PER_RUN=20000000
JEV_MAX_COST_USD_PER_RUN=1
JEV_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2
JEV_MAX_STATE_CHARS=2000
JEV_REVIEW_CONFIDENCE=0.5
