# Neon connection string (from Neon dashboard > Connection Details > Connection string)
# Use the "pooled" URL for production (includes ?pgbouncer=true)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Port for the HTTP server (SSE + health)
PORT=3000

# Bearer token clients send to the MCP server
COMM_VOICES_API_TOKEN=your-community-voices-api-token

# Reddit search query to track (any product, framework, or topic)
REDDIT_SEARCH_QUERY="model context protocol" OR mcp server

# Comma-separated public Discourse forums to ingest
DISCOURSE_BASE_URLS=https://forum.example.com,https://community.example.org

# Optional: route_signal POSTs ranked signals here (Slack incoming webhook, Zapier, n8n, etc.)
SIGNAL_WEBHOOK_URL=
